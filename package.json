{
  "name": "pagelens",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "github",
    "url": "https://github.com/Fractal-Tess/Svelte-Tauri"
  },
  "author": {
    "name": "Fractal-Tess",
    "email": "vgfractal@gmail.com",
    "url": "https://github.com/Fractal-Tess"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "test-apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:dowry": "bun run --cwd apps/dowry build",
    "build:test-apps": "turbo run build --filter='./test-apps/*'",
    "dev": "bun run --cwd apps/dowry dev",
    "format": "prettier --write .",
    "check": "bun run --cwd apps/dowry check",
    "svelte:build": "bun run --cwd apps/dowry svelte:build",
    "svelte:dev": "bun run --cwd apps/dowry svelte:dev",
    "start-apps": "turbo run start --filter='./test-apps/*' --ui=tui",
    "start-test-apps": "bun run start-apps"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prettier-plugin-toml": "^2.0.6",
    "lefthook": "^2.1.1",
    "turbo": "^2.4.0"
  }
}
